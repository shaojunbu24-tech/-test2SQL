{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:material-analysis:semantic-request:1.0",
  "title": "SemanticRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "mentions", "filters", "requestedMetrics", "responseMode", "confidence"],
  "properties": {
    "intent": {
      "enum": ["ANALYZE_MATERIAL_GAP", "LIST_MATERIAL_GAP_ANOMALIES"]
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "surface", "expectedType", "resolutionStatus"],
        "properties": {
          "slot": {"type": "string"},
          "surface": {"type": "string", "minLength": 1},
          "expectedType": {
            "enum": ["ProductionPlan", "ProcessTask", "Product", "Department"]
          },
          "resolutionStatus": {"const": "UNRESOLVED"}
        }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": {"type": "string"},
          "operator": {"enum": ["EQ", "IN", "GTE", "GT", "LTE", "LT", "BETWEEN"]},
          "value": {}
        }
      }
    },
    "timeRange": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["ABSOLUTE", "RELATIVE"]},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "relativeExpression": {"type": "string"}
      }
    },
    "requestedMetrics": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "threshold": {"type": ["number", "null"]},
    "diagnosisRequested": {"type": "boolean", "default": false},
    "responseMode": {"enum": ["SUMMARY", "DETAIL", "RANKED_LIST"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguities": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

