# OpenAI API 密钥；真实密钥只放在本机环境变量中，不要提交到代码库。
OPENAI_API_KEY=replace-with-your-api-key
# OpenAI 兼容服务地址；DeepSeek 使用下面这个地址。
OPENAI_BASE_URL=https://api.deepseek.com
# 使用的模型名称；请选择当前兼容服务中支持 JSON Output 的模型。
OPENAI_MODEL=replace-with-your-model-name
# MySQL 主机名或 IP。
DB_HOST=replace-with-database-host
# MySQL 端口，默认通常为 3306。
DB_PORT=3306
# 只读数据库用户名。
DB_USER=replace-with-readonly-user
# 只读数据库密码。
DB_PASSWORD=replace-with-database-password
# 当前项目数据库名称。
DB_NAME=mom-test
